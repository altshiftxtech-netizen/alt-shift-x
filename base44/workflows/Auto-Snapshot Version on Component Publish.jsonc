{
  "name": "Auto-Snapshot Version on Component Publish",
  "description": "Automatically creates a version history record whenever a component status changes to published.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"published\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Component"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_snapshot_version_on_component_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "snapshotComponentVersion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "snapshotComponentVersion"
  }
}