{
  "name": "Notify on Component Status Change",
  "description": "Sends notification when a component is published, rejected, or submitted for review",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"published\" or .trigger.data.status == \"rejected\" or .trigger.data.status == \"pending_review\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Component"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_on_component_status_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyOnComponentEvent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyOnComponentEvent"
  }
}