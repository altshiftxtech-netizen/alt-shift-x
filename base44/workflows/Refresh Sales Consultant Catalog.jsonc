{
  "name": "Refresh Sales Consultant Catalog",
  "description": "Rebuilds the live marketplace snapshot the sales consultant trains on, every 15 minutes, so recommendations always reflect currently published components.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": "2026-06-06T22:08:03.205000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "refresh_sales_consultant_catalog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshCatalogSnapshot",
            "args": {
              "task_secret_env": "INTERNAL_TASK_SECRET"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "refreshCatalogSnapshot"
  }
}