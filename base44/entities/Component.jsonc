{
  "name": "Component",
  "type": "object",
  "properties": {
    "builder_id": {
      "type": "string",
      "description": "ID of the builder who created this component"
    },
    "builder_name": {
      "type": "string",
      "description": "Optional display name for the builder, shown instead of the raw builder_id"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Unique component code (e.g., RP-CONSTRUCTION-1.0)"
    },
    "sku": {
      "type": "string",
      "description": "Sequential stock-keeping unit for inventory/record-keeping, e.g. ASX-00001"
    },
    "type": {
      "type": "string",
      "enum": [
        "X1",
        "X2",
        "X3",
        "X4",
        "X5"
      ],
      "description": "X1: Reading Protocols | X2: Prophecy Models | X3: Speed Profiles | X4: Reason Councils | X5: Complete Agents"
    },
    "category": {
      "type": "string",
      "enum": [
        "Military & Business Strategy",
        "AI Agent Development",
        "Marketplace & Deployment Kits",
        "Pedigree Specialized Pairings",
        "Legal & Compliance",
        "Operational Engineering",
        "Human Capital",
        "Strategic Growth",
        "Knowledge Book Tiles"
      ]
    },
    "description": {
      "type": "string"
    },
    "long_description": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "developer"
              }
            },
            {
              "user_condition": {
                "role": "builder"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "developer"
              }
            },
            {
              "user_condition": {
                "role": "builder"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "schema": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Output schema field names",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "developer"
              }
            },
            {
              "user_condition": {
                "role": "builder"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "price": {
      "type": "number",
      "description": "Monthly price per installation in USD"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe recurring price ID for this component \u2014 auto-created on first checkout"
    },
    "paypal_plan_id": {
      "type": "string",
      "description": "PayPal recurring billing plan ID for this component \u2014 auto-created on first PayPal checkout"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "published",
        "rejected",
        "shelved"
      ],
      "default": "draft"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "When true, this component is pinned/spotlighted in marketplace and homepage placement slots."
    },
    "pinned_position": {
      "type": "number",
      "description": "Optional manual sort weight for featured/pinned components \u2014 lower numbers appear first."
    },
    "requires_legal_acceptance": {
      "type": "boolean",
      "default": false,
      "description": "When true, the buyer must walk through and accept all legal disclaimers/agreements before checkout is unlocked (e.g. SAFEGUARD-1.0)."
    },
    "include_in_pipelines": {
      "type": "boolean",
      "default": false,
      "description": "Builder opt-in: when true, this component is eligible to be bundled into the shared 'best-of' Pipeline pool that enterprise pipeline keys can access."
    },
    "include_in_open_pipeline": {
      "type": "boolean",
      "default": false,
      "description": "Builder opt-in: when true, this component is contributed to the Open Contribution Pipeline \u2014 the open pool any builder can add to, sold as a quarterly subscription."
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "installs_count": {
      "type": "number",
      "default": 0
    },
    "trust_score": {
      "type": "number",
      "default": 0
    },
    "trust_breakdown": {
      "type": "object",
      "properties": {
        "performance": {
          "type": "number"
        },
        "safety": {
          "type": "number"
        },
        "satisfaction": {
          "type": "number"
        },
        "retention": {
          "type": "number"
        }
      }
    },
    "certified": {
      "type": "boolean",
      "default": false
    },
    "endpoint_url": {
      "type": "string",
      "description": "URL where the extraction API is deployed",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "developer"
              }
            },
            {
              "user_condition": {
                "role": "builder"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "stale_flagged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the no-installs stale flag notification was last sent"
    },
    "low_rating_alert_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a low-rating alert was last sent to the builder"
    },
    "book_meta": {
      "type": "object",
      "description": "Metadata for Knowledge Book Tile components (books turned into knowledge components). Only Magna Dev creates these.",
      "properties": {
        "book_title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "publication_year": {
          "type": "number"
        },
        "isbn": {
          "type": "string"
        },
        "key_concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge_domain": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "builder_id",
    "name",
    "code",
    "type",
    "category",
    "description",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.builder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.builder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}