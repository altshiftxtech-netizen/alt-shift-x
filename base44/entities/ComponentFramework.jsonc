{
  "name": "ComponentFramework",
  "type": "object",
  "properties": {
    "builder_id": {
      "type": "string"
    },
    "framework_name": {
      "type": "string",
      "description": "Name of this framework preset"
    },
    "apply_to_all": {
      "type": "boolean",
      "default": false,
      "description": "Inject this framework into all future component builds"
    },
    "project": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "project_name": {
          "type": "string"
        },
        "project_code": {
          "type": "string"
        },
        "industry_vertical": {
          "type": "string"
        },
        "target_market": {
          "type": "string"
        },
        "platform_type": {
          "type": "string",
          "enum": [
            "SaaS",
            "API",
            "Embedded",
            "White-Label",
            "Mobile"
          ]
        }
      }
    },
    "component_identity": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "component_type": {
          "type": "string",
          "enum": [
            "X1",
            "X2",
            "X3",
            "X4",
            "X5"
          ]
        },
        "category": {
          "type": "string"
        },
        "version_scheme": {
          "type": "string"
        },
        "license_type": {
          "type": "string",
          "enum": [
            "Proprietary",
            "MIT",
            "Apache-2.0",
            "GPL-3.0",
            "YottaJoule-Licensed"
          ]
        },
        "base_components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Licensed components this build extends"
        }
      }
    },
    "ai_behavior": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "model_preference": {
          "type": "string",
          "enum": [
            "gpt-4o",
            "claude-3",
            "gemini-pro",
            "yottajoule-core",
            "auto"
          ]
        },
        "context_window": {
          "type": "string",
          "enum": [
            "4k",
            "16k",
            "32k",
            "128k"
          ]
        },
        "extraction_mode": {
          "type": "string",
          "enum": [
            "precise",
            "balanced",
            "exploratory"
          ]
        },
        "hallucination_guard": {
          "type": "boolean",
          "default": true
        },
        "confidence_threshold": {
          "type": "number",
          "default": 0.85
        },
        "fallback_behavior": {
          "type": "string",
          "enum": [
            "flag",
            "skip",
            "escalate",
            "default_value"
          ]
        }
      }
    },
    "input_output": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "accepted_file_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_file_size_mb": {
          "type": "number",
          "default": 25
        },
        "output_format": {
          "type": "string",
          "enum": [
            "JSON",
            "CSV",
            "PDF",
            "Word",
            "Structured-JSON",
            "Custom"
          ]
        },
        "schema_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Output field names"
        },
        "supports_batch": {
          "type": "boolean",
          "default": false
        },
        "webhook_on_complete": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "compliance_safety": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "regulatory_frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. SOC2, GDPR, ISO27001"
        },
        "data_residency": {
          "type": "string",
          "enum": [
            "US",
            "EU",
            "AU",
            "Global",
            "Custom"
          ]
        },
        "pii_handling": {
          "type": "string",
          "enum": [
            "redact",
            "tokenize",
            "allow",
            "flag"
          ]
        },
        "audit_logging": {
          "type": "boolean",
          "default": true
        },
        "sensitive_content_scan": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "pricing_monetization": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "pricing_model": {
          "type": "string",
          "enum": [
            "flat-monthly",
            "per-call",
            "tiered",
            "freemium",
            "enterprise-only"
          ]
        },
        "base_price": {
          "type": "number"
        },
        "free_tier_calls": {
          "type": "number",
          "default": 0
        },
        "overage_rate": {
          "type": "number"
        },
        "trial_days": {
          "type": "number",
          "default": 14
        },
        "target_margin_pct": {
          "type": "number",
          "default": 70
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "deploy_target": {
          "type": "string",
          "enum": [
            "marketplace",
            "private",
            "white-label",
            "api-only"
          ]
        },
        "auto_publish": {
          "type": "boolean",
          "default": false
        },
        "ci_cd_enabled": {
          "type": "boolean",
          "default": false
        },
        "rollback_strategy": {
          "type": "string",
          "enum": [
            "automatic",
            "manual",
            "none"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "both"
          ]
        }
      }
    },
    "branding_docs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "brand_name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "primary_color": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "generate_readme": {
          "type": "boolean",
          "default": true
        },
        "generate_api_docs": {
          "type": "boolean",
          "default": true
        },
        "export_word": {
          "type": "boolean",
          "default": false
        },
        "export_pdf": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "builder_id",
    "framework_name"
  ]
}