{
  "name": "AffiliateAttribution",
  "type": "object",
  "properties": {
    "ref_code": {
      "type": "string",
      "description": "The affiliate link code that drove this attribution"
    },
    "campaign": {
      "type": "string",
      "description": "Campaign name copied from the link at attribution time"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user ID of the person who signed up"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "signed_up_at": {
      "type": "string",
      "format": "date-time"
    },
    "purchased": {
      "type": "boolean",
      "default": false,
      "description": "Whether this attributed user made any paid purchase"
    },
    "purchase_type": {
      "type": "string",
      "enum": [
        "none",
        "subscription",
        "marketplace"
      ],
      "default": "none",
      "description": "Type of purchase: paid subscription or marketplace component purchase"
    },
    "cart_amount": {
      "type": "number",
      "default": 0,
      "description": "Total cart / purchase amount in USD at attribution"
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ref_code"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}