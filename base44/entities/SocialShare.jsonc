{
  "name": "SocialShare",
  "type": "object",
  "properties": {
    "builder_id": {
      "type": "string",
      "description": "User ID of the builder"
    },
    "platform": {
      "type": "string",
      "enum": [
        "twitter",
        "linkedin",
        "tiktok",
        "instagram",
        "facebook",
        "copy_link"
      ],
      "description": "Social platform shared to"
    },
    "component_id": {
      "type": "string",
      "description": "Component being shared (optional)"
    },
    "component_name": {
      "type": "string"
    },
    "share_url": {
      "type": "string",
      "description": "The URL that was shared"
    },
    "video_downloaded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the promo video was downloaded"
    }
  },
  "required": [
    "builder_id",
    "platform"
  ],
  "rls": {
    "create": {
      "data.builder_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.builder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}