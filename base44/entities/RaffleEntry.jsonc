{
  "name": "RaffleEntry",
  "type": "object",
  "properties": {
    "raffle_id": {
      "type": "string",
      "description": "Raffle this entry belongs to."
    },
    "raffle_title": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Entrant's user id."
    },
    "user_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Date of birth used for the age check."
    },
    "age_at_as_of": {
      "type": "number",
      "description": "Computed age as of the policy's as-of date."
    },
    "eligible": {
      "type": "boolean",
      "default": true,
      "description": "false = failed the age policy; not counted as a valid entry."
    },
    "ineligible_reason": {
      "type": "string",
      "enum": [
        "age_fail",
        "terms_fail",
        "unreachable",
        "claim_incomplete",
        "other"
      ],
      "description": "Set when eligible = false or winner is disqualified later."
    },
    "winner_status": {
      "type": "string",
      "enum": [
        "entrant",
        "pending_draw",
        "pending_verification",
        "verified",
        "pending_claim",
        "claimed",
        "fulfilled"
      ],
      "default": "entrant"
    },
    "is_alternate": {
      "type": "boolean",
      "default": false
    },
    "alternate_rank": {
      "type": "number"
    }
  },
  "required": [
    "raffle_id",
    "dob"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}