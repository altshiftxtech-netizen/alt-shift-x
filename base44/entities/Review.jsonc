{
  "name": "Review",
  "type": "object",
  "properties": {
    "component_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who submitted the review"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string"
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "component_id",
    "user_id",
    "rating"
  ]
}