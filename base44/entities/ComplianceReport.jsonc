{
  "name": "ComplianceReport",
  "type": "object",
  "properties": {
    "report_type": {
      "type": "string",
      "enum": [
        "soc2",
        "weekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "total_tests_run": {
      "type": "number"
    },
    "pass_rate": {
      "type": "number",
      "description": "Pass rate percentage (0-100)"
    },
    "security_score": {
      "type": "number",
      "description": "Security audit score (0-100)"
    },
    "performance_score": {
      "type": "number",
      "description": "Performance benchmark score (0-100)"
    },
    "reliability_score": {
      "type": "number",
      "description": "Uptime/reliability score (0-100)"
    },
    "critical_issues": {
      "type": "number",
      "default": 0
    },
    "warnings": {
      "type": "number",
      "default": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to downloadable PDF report"
    }
  },
  "required": [
    "report_type",
    "period_start",
    "period_end",
    "pass_rate"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}