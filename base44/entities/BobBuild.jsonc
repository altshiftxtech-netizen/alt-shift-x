{
  "name": "BobBuild",
  "type": "object",
  "properties": {
    "builder_id": {
      "type": "string",
      "description": "Base44 user ID of the builder who rendered this B.O.B.Init build"
    },
    "stack": {
      "type": "string",
      "description": "Project stack chosen in the B.O.B.Init terminal (e.g. nextjs, react)"
    },
    "database": {
      "type": "string",
      "description": "Database engine selected for the PWA (e.g. mongodb, postgresql, mysql, sqlite, supabase, redis)"
    },
    "shim": {
      "type": "string",
      "description": "Self-Healing Shim mode (auto/manual)"
    },
    "budget": {
      "type": "number",
      "description": "Build budget allocated in the terminal"
    },
    "tier": {
      "type": "string"
    },
    "build_mode": {
      "type": "string",
      "enum": [
        "command",
        "projectjson",
        "texttocode"
      ],
      "default": "command",
      "description": "Which B.O.B.Init authoring mode produced this build. 'projectjson' (raw code mode) qualifies for the half-price PWA incentive."
    },
    "half_price": {
      "type": "boolean",
      "default": false,
      "description": "True when this build was authored in project.json code mode \u2014 the build fee is halved ($4,750 instead of $9,500) as a learn-to-code incentive."
    },
    "hardening": {
      "type": "object",
      "description": "110% Hardened Standard configuration \u2014 fail-closed ComponentFramework settings",
      "properties": {
        "hallucination_guard": {
          "type": "boolean",
          "default": true
        },
        "confidence_threshold": {
          "type": "number",
          "default": 0.85
        },
        "audit_logging": {
          "type": "boolean",
          "default": true
        },
        "regulatory_framework": {
          "type": "string",
          "default": "Blackstone Protocol"
        },
        "environment": {
          "type": "string",
          "default": "production"
        },
        "rollback_strategy": {
          "type": "string",
          "default": "automatic"
        },
        "x1_ledger": {
          "type": "boolean",
          "default": true
        },
        "x2_sensor": {
          "type": "boolean",
          "default": true
        },
        "x4_guard": {
          "type": "boolean",
          "default": true
        },
        "x5_healing": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "selected_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Feature ids selected on the Feature Selection page",
      "default": []
    },
    "feature_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Human-readable labels of the selected modules (for display in dashboards)",
      "default": []
    },
    "rules": {
      "type": "string",
      "description": "Rules-engine text injected into the manifest"
    },
    "code_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of uploaded code-injection files",
      "default": []
    },
    "api_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "esi_score": {
      "type": "number",
      "default": 0,
      "description": "Environment-Sovereign-Index score 0-100"
    },
    "pwa_name": {
      "type": "string",
      "description": "Display name used inside the generated PWA manifest"
    },
    "build_code": {
      "type": "string",
      "description": "Short build code, e.g. ASX-BUILD-XXXXX"
    },
    "manifest_json": {
      "type": "string",
      "description": "The generated PWA web-app manifest JSON string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rendered",
        "archived"
      ],
      "default": "rendered"
    }
  },
  "required": [
    "builder_id"
  ],
  "rls": {
    "create": {
      "data.builder_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.builder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.builder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.builder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}