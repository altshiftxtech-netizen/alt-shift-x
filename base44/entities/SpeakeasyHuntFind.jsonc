{
  "name": "SpeakeasyHuntFind",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who found the item"
    },
    "user_name": {
      "type": "string"
    },
    "fixture_id": {
      "type": "string",
      "description": "Fixture that was discovered"
    },
    "item_name": {
      "type": "string"
    },
    "prize_type": {
      "type": "string"
    },
    "prize_value": {
      "type": "string"
    },
    "found_at": {
      "type": "string",
      "format": "date-time"
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "fixture_id"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}