{
  "name": "BlogReaction",
  "type": "object",
  "properties": {
    "article_slug": {
      "type": "string",
      "description": "Slug of the article this reaction belongs to"
    },
    "emoji": {
      "type": "string",
      "description": "The reaction emoji chosen, e.g. \ud83d\udc4d \u2764\ufe0f \ud83c\udf89 \ud83d\udd25 \ud83d\udc4f"
    }
  },
  "required": [
    "article_slug",
    "emoji"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}