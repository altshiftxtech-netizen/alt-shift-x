{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "developer",
        "builder",
        "staff"
      ],
      "default": "developer",
      "description": "New verified free accounts are developers; admin, user, builder and staff retain their assigned roles."
    },
    "speakeasy_alias": {
      "type": "string",
      "description": "Optional alias name shown instead of the user's real name in Speakeasy rooms \u2014 identity protection for enterprise members"
    },
    "speakeasy_ghost_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user's bubble is hidden in the Ballroom and other rooms; in exchange they cannot see or interact with other members' bubbles"
    }
  }
}