{
  "name": "ComponentAnnexRequest",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string",
      "description": "Base44 user ID of the Sovereign requester"
    },
    "requester_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Short title of the requested catalog annex / component"
    },
    "domain": {
      "type": "string",
      "description": "Intelligence domain or category the annex belongs to"
    },
    "brief": {
      "type": "string",
      "description": "Full description of the requested capability"
    },
    "priority": {
      "type": "string",
      "enum": [
        "standard",
        "high",
        "critical"
      ],
      "default": "high"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "in_review",
        "scoping",
        "building",
        "delivered",
        "declined"
      ],
      "default": "queued"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "brief"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}