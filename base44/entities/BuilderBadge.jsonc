{
  "name": "BuilderBadge",
  "type": "object",
  "properties": {
    "builder_id": {
      "type": "string",
      "description": "User ID of the builder"
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze"
    },
    "total_installs": {
      "type": "number",
      "default": 0
    },
    "monthly_installs": {
      "type": "number",
      "default": 0
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "component_count": {
      "type": "number",
      "default": 0
    },
    "certified_count": {
      "type": "number",
      "default": 0
    },
    "momentum_score": {
      "type": "number",
      "default": 0
    },
    "leaderboard_score": {
      "type": "number",
      "default": 0
    },
    "badges_earned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code for this builder"
    },
    "referral_count": {
      "type": "number",
      "default": 0
    },
    "referral_earnings": {
      "type": "number",
      "default": 0
    },
    "revenue_share_pct": {
      "type": "number",
      "default": 70
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "stripe_connect_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "restricted",
        "disabled"
      ]
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal"
      ],
      "default": "stripe",
      "description": "Which payout rail the builder uses to receive earnings"
    },
    "paypal_payout_email": {
      "type": "string",
      "description": "PayPal account email where builder payouts are sent"
    },
    "display_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "facebook": {
      "type": "string",
      "description": "Facebook profile URL"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "location": {
      "type": "string"
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_tier": {
      "type": "string",
      "enum": [
        "standard",
        "insured",
        "verified"
      ],
      "default": "standard",
      "description": "Builder's escrow policy tier: standard (20%), insured Safe Harbor (5%), or TMT-3 verified (10%)"
    },
    "insurance_cert_url": {
      "type": "string",
      "description": "URL to uploaded ACORD E&O insurance certificate"
    },
    "insurance_cert_name": {
      "type": "string",
      "description": "Filename of uploaded ACORD certificate"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date",
      "description": "E&O policy expiry date \u2014 alerts fire 30 days before"
    },
    "insurance_verified": {
      "type": "boolean",
      "default": false,
      "description": "Admin-confirmed insurance verification status"
    },
    "insurance_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an insurance-expiry alert was last sent"
    },
    "tmt3_passed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this builder has a component that passed the TMT-3 Sentinel audit"
    },
    "tmt3_passed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of TMT-3 audit pass"
    },
    "escrow_holdback_pct": {
      "type": "number",
      "default": 20,
      "description": "Current effective escrow holdback percentage"
    },
    "safe_harbor_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether Safe Harbor (insured) status is currently active"
    },
    "last_calculated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "builder_id"
  ]
}