{
  "name": "Pipeline",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the pipeline (e.g. 'Alt+Shift+X Exclusive \u2014 Magna Dev Suite')"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier, e.g. altshiftx-exclusive"
    },
    "tagline": {
      "type": "string",
      "description": "Short marketing line shown on the marketplace card"
    },
    "description": {
      "type": "string",
      "description": "Full marketing description of what the pipeline bundles and who it's for"
    },
    "pipeline_type": {
      "type": "string",
      "enum": [
        "curated_exclusive",
        "best_of_pool",
        "open_contribution"
      ],
      "default": "curated_exclusive",
      "description": "curated_exclusive: the Exclusive Pool \u2014 Alt+Shift+X / Resident Developer components only. best_of_pool: the curated 'best of all' pool (Component.include_in_pipelines). open_contribution: the open pool any builder can contribute to (Component.include_in_open_pipeline), billed as a quarterly subscription."
    },
    "billing_cadence": {
      "type": "string",
      "enum": [
        "one_time",
        "quarterly"
      ],
      "default": "one_time",
      "description": "one_time: full payment unlocks the key instantly (the two pools). quarterly: recurring subscription billed 4x/year (the open contribution pipeline)."
    },
    "buyer_kind": {
      "type": "string",
      "enum": [
        "business",
        "standard"
      ],
      "default": "business",
      "description": "business: enterprise/company pipeline key (large-deal pricing & W-9/contract flow). standard: regular buyer."
    },
    "component_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Component codes explicitly included (curated_exclusive). For best_of_pool / open_contribution this can be left empty \u2014 membership is derived from the component opt-in flags."
    },
    "resident_developer_ready": {
      "type": "boolean",
      "default": false,
      "description": "When true, this curated pipeline will expand to include all Resident Developer components in the future (currently Magna Dev only)."
    },
    "price": {
      "type": "number",
      "description": "For one_time pipelines: total one-time enterprise price in USD. For quarterly pipelines: the amount billed each quarter in USD."
    },
    "installs_count": {
      "type": "number",
      "default": 0,
      "description": "Number of enterprise keys provisioned for this pipeline."
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Surface prominently in the marketplace enterprise section"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug",
    "pipeline_type",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}