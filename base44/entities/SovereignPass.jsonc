{
  "name": "SovereignPass",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "sprint",
        "flex",
        "duo",
        "apex"
      ]
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seat_limit": {
      "type": "number",
      "description": "Zero means unlimited"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "test_mode": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "tier",
    "stripe_session_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}