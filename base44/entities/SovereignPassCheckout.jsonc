{
  "name": "SovereignPassCheckout",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "tier": {
      "type": "string"
    },
    "expected_amount": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "discount_percent": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ]
    },
    "test_mode": {
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "stripe_session_id",
    "tier",
    "expected_amount",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}