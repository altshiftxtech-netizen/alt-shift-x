{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "enterprise",
        "base_operator",
        "strategic_architect",
        "sovereign_commander"
      ],
      "default": "starter",
      "description": "Subscription plan. 'free' is the baseline tier a user reverts to on downgrade \u2014 all records preserved, paid benefits hidden."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "past_due",
        "trialing",
        "incomplete",
        "unpaid"
      ],
      "default": "active"
    },
    "api_calls_used": {
      "type": "number",
      "default": 0
    },
    "current_period_start": {
      "type": "string",
      "format": "date"
    },
    "current_period_end": {
      "type": "string",
      "format": "date"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "dunning_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time a failed-payment reminder was sent"
    },
    "quota_nudged_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time a quota upgrade nudge was sent"
    },
    "winback_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a win-back email was sent after cancellation"
    }
  },
  "required": [
    "user_id",
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}