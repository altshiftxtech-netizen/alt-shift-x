{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "key_hash": {
      "type": "string",
      "description": "Hashed API key for secure storage"
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "name",
    "key_hash"
  ]
}