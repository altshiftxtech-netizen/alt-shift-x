{
  "name": "CrmContact",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID of the admin/staff who owns this contact record"
    },
    "kind": {
      "type": "string",
      "enum": [
        "individual",
        "company"
      ],
      "default": "individual",
      "description": "Whether this record is a person or an organization"
    },
    "name": {
      "type": "string",
      "description": "Full name (individual) or company name"
    },
    "company_id": {
      "type": "string",
      "description": "For individuals: the CrmContact id of the company they belong to"
    },
    "title": {
      "type": "string",
      "description": "Job title / role"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "fax": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CrmGroup ids this contact belongs to",
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "lead",
        "customer",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}