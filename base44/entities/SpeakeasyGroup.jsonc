{
  "name": "SpeakeasyGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Group display name, e.g. 'Construction Builders'"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier used at /speakeasy/groups/:slug"
    },
    "description": {
      "type": "string",
      "description": "Short blurb about what this circle is for"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83d\udecb\ufe0f",
      "description": "Emoji icon shown on the group card"
    },
    "accent": {
      "type": "string",
      "default": "#C8A95B",
      "description": "Hex accent color for the group's theming"
    },
    "created_by_id": {
      "type": "string",
      "description": "User who founded the circle"
    },
    "created_by_name": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "post_count": {
      "type": "number",
      "default": 0
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "data.created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}