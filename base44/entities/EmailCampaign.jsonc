{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "preview_text": {
      "type": "string",
      "description": "Short preheader/preview text"
    },
    "body": {
      "type": "string",
      "description": "Email body content (HTML or markdown-ish). Sent as the email body."
    },
    "audience": {
      "type": "string",
      "enum": [
        "all_users",
        "paying",
        "builders",
        "newsletter"
      ],
      "default": "newsletter",
      "description": "Which subscriber segment this campaign targets"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sending",
        "sent",
        "failed"
      ],
      "default": "draft"
    },
    "sent_count": {
      "type": "number",
      "default": 0,
      "description": "How many recipients were successfully emailed"
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "recipient_count": {
      "type": "number",
      "default": 0,
      "description": "Total recipients targeted at send time"
    },
    "created_by_name": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}