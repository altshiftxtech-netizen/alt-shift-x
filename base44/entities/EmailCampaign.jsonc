{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "preview_text": {
      "type": "string",
      "description": "Short preheader/preview text"
    },
    "body": {
      "type": "string",
      "description": "Email body content (HTML or markdown-ish). Sent as the email body."
    },
    "audience": {
      "type": "string",
      "enum": [
        "all_users",
        "paying",
        "builders",
        "newsletter"
      ],
      "default": "newsletter",
      "description": "Which subscriber segment this campaign targets"
    },
    "attachments": {
      "type": "array",
      "description": "Files attached to this email. Stored as uploaded file URLs.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "If set, the campaign is sent automatically at this time instead of immediately."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sending",
        "sent",
        "failed",
        "archived"
      ],
      "default": "draft"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether the campaign has been archived out of the active history view"
    },
    "sent_count": {
      "type": "number",
      "default": 0,
      "description": "How many recipients were successfully emailed"
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "open_count": {
      "type": "number",
      "default": 0,
      "description": "Number of unique recipients who opened the email (read receipts)"
    },
    "recipient_count": {
      "type": "number",
      "default": 0,
      "description": "Total recipients targeted at send time"
    },
    "created_by_name": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}