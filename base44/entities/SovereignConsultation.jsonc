{
  "name": "SovereignConsultation",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string",
      "description": "Base44 user ID of the Sovereign client"
    },
    "requester_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "description": "What the consultation is about"
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "description": "Requested start time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event id once booked"
    },
    "meet_link": {
      "type": "string",
      "description": "Google Meet link for the consultation"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "requested"
    },
    "tax_id": {
      "type": "string",
      "description": "Non-profit Tax ID for $0 Sovereign Credit validation"
    },
    "entity_type": {
      "type": "string",
      "description": "For-Profit, Non-Profit, Government, Individual"
    },
    "role_title": {
      "type": "string",
      "description": "Client's role / title"
    },
    "doc_url": {
      "type": "string",
      "description": "URL of uploaded intent document"
    },
    "payment_confirmation_id": {
      "type": "string",
      "description": "Stripe session ID or promo confirmation ID \u2014 the gate key"
    },
    "promo_code": {
      "type": "string",
      "description": "Applied promo code (e.g. SOV-NONPROFIT-2027)"
    },
    "final_price": {
      "type": "number",
      "description": "Final price after promo (0 for non-profit credit)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "promo_applied"
      ],
      "default": "pending_payment"
    }
  },
  "required": [
    "topic",
    "start"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}