{
  "name": "SovereignInvoice",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Base44 user ID of the invoice issuer"
    },
    "engine_code": {
      "type": "string",
      "default": "SOVEREIGN-INVOICE-ENGINE-1.0",
      "description": "The forensic invoice engine that generated this invoice"
    },
    "invoice_number": {
      "type": "string",
      "description": "Sequential invoice id, e.g. INV-001"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "policy_id": {
      "type": "string",
      "description": "SovereignPolicy id whose rates were applied"
    },
    "policy_name": {
      "type": "string"
    },
    "hub": {
      "type": "string",
      "description": "Operating hub / region, e.g. SEATTLE"
    },
    "bill_to": {
      "type": "string",
      "description": "Client / recipient name"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit_rate": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "total_contract_value": {
      "type": "number",
      "default": 0,
      "description": "Total invoice value (tcv), encoded into the QR"
    },
    "forensic_hash": {
      "type": "string",
      "description": "BIT-HASH forensic integrity hash of the invoice payload"
    },
    "qr_payload": {
      "type": "string",
      "description": "The exact JSON string encoded into the forensic QR code"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued"
      ],
      "default": "draft"
    }
  },
  "required": [
    "owner_id",
    "invoice_number"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}