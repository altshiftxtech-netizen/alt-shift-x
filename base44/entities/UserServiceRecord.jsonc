{
  "name": "UserServiceRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID this record relates to"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "login_issue",
        "document_request",
        "privilege_change",
        "report",
        "general"
      ],
      "description": "Category of the service record"
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "delivery_channel": {
      "type": "string",
      "enum": [
        "none",
        "email",
        "mail",
        "fax"
      ],
      "default": "none",
      "description": "For document requests \u2014 how the deliverable should be sent"
    },
    "delivery_target": {
      "type": "string",
      "description": "Email address, mailing address, or fax number for delivery"
    },
    "delivered": {
      "type": "boolean",
      "default": false
    },
    "handled_by": {
      "type": "string",
      "description": "Name of the admin/staff member who handled this record"
    },
    "handled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "record_type",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}