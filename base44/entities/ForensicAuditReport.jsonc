{
  "name": "ForensicAuditReport",
  "type": "object",
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "The UTC calendar date this daily sweep covers"
    },
    "template": {
      "type": "string",
      "default": "EXPERTMINDS-REPORT-TEMPLATE-1.0",
      "description": "The court-ready report layout used"
    },
    "total_exports": {
      "type": "number",
      "default": 0
    },
    "verified_count": {
      "type": "number",
      "default": 0
    },
    "anomaly_count": {
      "type": "number",
      "default": 0,
      "description": "Number of exports with one or more anomaly flags"
    },
    "flag_totals": {
      "type": "object",
      "description": "Counts per flag type across the day",
      "properties": {
        "DATA_COLLECTION_RISK": {
          "type": "number"
        },
        "UNAUTHORIZED_ENVIRONMENT": {
          "type": "number"
        },
        "INTEGRITY_COMPROMISED": {
          "type": "number"
        }
      },
      "default": {}
    },
    "anomalies": {
      "type": "array",
      "description": "Highlighted anomalies detected in the sweep",
      "items": {
        "type": "object",
        "properties": {
          "log_id": {
            "type": "string"
          },
          "downloader_email": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": []
    },
    "swept_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "report_date"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}