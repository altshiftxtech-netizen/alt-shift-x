{
  "name": "CrmGroup",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID of the admin/staff who created this group"
    },
    "name": {
      "type": "string",
      "description": "Group / segment name, e.g. 'VIP Clients' or 'Newsletter'"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "#6366f1",
      "description": "Hex accent color for the group chip"
    },
    "member_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}