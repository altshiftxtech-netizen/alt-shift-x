{
  "name": "DownloadCheckpoint",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID this checkpoint belongs to"
    },
    "last_download_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the user's most recent component ZIP download \u2014 used to offer an incremental 'since last checkpoint' download."
    },
    "last_download_count": {
      "type": "number",
      "default": 0,
      "description": "How many components were in the last download"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}