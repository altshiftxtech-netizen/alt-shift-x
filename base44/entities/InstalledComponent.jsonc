{
  "name": "InstalledComponent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "component_id": {
      "type": "string",
      "description": "e.g. ironclad-protocol"
    },
    "component_name": {
      "type": "string"
    },
    "component_code": {
      "type": "string"
    },
    "component_type": {
      "type": "string",
      "enum": [
        "X1",
        "X2",
        "X4"
      ]
    },
    "installed_at": {
      "type": "string",
      "format": "date"
    },
    "last_used": {
      "type": "string"
    },
    "calls_this_month": {
      "type": "number",
      "default": 0
    },
    "trust_score": {
      "type": "number"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription that provisioned this install"
    },
    "paypal_subscription_id": {
      "type": "string",
      "description": "PayPal subscription that provisioned this install"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "component_id",
    "component_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}